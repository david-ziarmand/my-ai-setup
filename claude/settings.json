{
  "permissions": {
    "defaultMode": "default"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "node {{CLAUDE_HOME}}/statusline.js"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false
  },
  "language": "Ukrainian",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "voiceEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false
}
